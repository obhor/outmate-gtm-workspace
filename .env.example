# Copy to server/.env and fill in. Never commit real values.

# Postgres connection string (e.g. Neon free tier)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Demo auth — the password evaluators use to sign in
DEMO_AUTH_TOKEN=gtm-demo-2026

# Optional: LLM provider (Anthropic-compatible endpoint).
# Without this the system runs fully in rules-based demo mode.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com/anthropic
MODEL_NAME=deepseek-v4-flash

# Demo budget per research/enrichment job (USD)
DEMO_BUDGET_USD=0.50
FRESHNESS_THRESHOLD_DAYS=60
PORT=8080
